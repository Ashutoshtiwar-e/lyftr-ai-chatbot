# Copy to .env and fill in real values. NEVER commit a real .env or real keys.
# LLM key pool — at least 2 keys, comma-separated, in order (key_1, key_2, ...).
# Both keys below are for gemini/gemini-3.5-flash.
LLM_API_KEYS=your-first-gemini-api-key,your-second-gemini-api-key
LLM_MODEL=gemini/gemini-3.5-flash
# SQLite location. In Docker this must be under the /data volume.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the backend.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Set to true on the deployed backend so the X-Simulate-Failure hook works.
ENABLE_FAILURE_SIMULATION=true
# Frontend build-time backend URL (used by Docker and by Render/Vercel).
VITE_BACKEND_URL=http://localhost:8000
# Optional: OpenRouter API key. If both Gemini keys fail for real (not in a
# failover simulation), the backend tries the same Gemini model via
# OpenRouter as a last resort. Leave blank to disable it.
OPENROUTER_API_KEY=
